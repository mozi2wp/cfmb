{
	"name": "custom-fields-meta-box",
	"version": "1.0.0",
	"private": true,
	"description": "Custom fields, meta boxes and content modeling for WordPress.",
	"license": "GPL-2.0-or-later",
	"author": "Mozi2WP",
	"scripts": {
		"prebuild": "node bin/build-icons.js && node bin/build-ui-icons.js",
		"build:icons": "node bin/build-icons.js && node bin/build-ui-icons.js",
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js assets/src",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.scss\"",
		"format": "wp-scripts format assets/src",
		"test:unit": "wp-scripts test-unit-js --testPathPattern=tests/js",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
		"env": "wp-env",
		"plugin-zip": "wp-scripts plugin-zip",
		"release": "composer install --no-dev --optimize-autoloader --no-scripts && npm run build && wp-scripts plugin-zip && composer install",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/custom-fields-meta-box vendor/bin/phpunit"
	},
	"devDependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@playwright/test": "^1.47.0",
		"@wordpress/date": "^5.57.0",
		"@wordpress/e2e-test-utils-playwright": "^1.8.0",
		"@wordpress/env": "^10.8.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/scripts": "^30.0.0"
	},
	"files": [
		"build",
		"assets",
		"src",
		"vendor/autoload.php",
		"vendor/composer",
		"custom-fields-meta-box.php",
		"uninstall.php",
		"composer.json",
		"readme.txt",
		"vendor-prefixed"
	],
	"dependencies": {
		"leaflet": "^1.9.4"
	}
}
