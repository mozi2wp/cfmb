<?xml version="1.0"?>
<phpunit
	bootstrap="tests/php/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
>
	<testsuites>
		<testsuite name="cfmb">
			<directory suffix="Test.php">./tests/php/</directory>
		</testsuite>
	</testsuites>
	<extensions>
		<extension class="CFMB\Tests\Sync_Folder_Extension"/>
	</extensions>
</phpunit>
