{
	"name": "mozi2wp/custom-fields-meta-box",
	"description": "Custom fields, meta boxes and content modeling for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Mozi2WP",
			"homepage": "https://mozi2wp.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"enshrined/svg-sanitize": "^0.20"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wp-cli-stubs": "^2.11",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.12",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.6",
		"yoast/phpunit-polyfills": "^2.0",
		"brianhenryie/strauss": "^0.19"
	},
	"autoload": {
		"psr-4": {
			"CFMB\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CFMB\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"prefix-namespaces": "strauss"
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "CFMB\\Vendor\\",
			"classmap_prefix": "CFMB_Vendor_",
			"constant_prefix": "CFMB_VENDOR_",
			"packages": [
				"enshrined/svg-sanitize"
			],
			"delete_vendor_packages": true
		}
	}
}
